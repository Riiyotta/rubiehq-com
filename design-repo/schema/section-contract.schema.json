{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Section contract",
  "description": "Closed shape of every sections/*.json (checked by extraction/verify_all.py). `source` is provenance (what the DOM/component is, traceable to a file range); `semantic` is the AI-facing taxonomy. They are separate on purpose: wrapper/class naming never decides the taxonomy.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "category",
    "label",
    "tag",
    "purpose",
    "purposeIsInferred",
    "nameSource",
    "evidence",
    "content",
    "constraints",
    "motion",
    "assetRoles",
    "generatedAssetRoles",
    "implementedBy",
    "scope",
    "source",
    "semantic",
    "retrievalEligible"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z]+\\.[a-z0-9-]+$"
    },
    "category": {
      "enum": [
        "SHELL",
        "HERO",
        "NARRATIVE",
        "FEATURES",
        "PROOF",
        "CTA",
        "FAQ",
        "INDEX"
      ]
    },
    "label": {
      "type": "string"
    },
    "tag": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*$"
    },
    "purpose": {
      "type": "string",
      "minLength": 20
    },
    "purposeIsInferred": {
      "type": "boolean"
    },
    "nameSource": {
      "type": "string"
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "instances",
        "routes",
        "measuredFrom"
      ],
      "properties": {
        "level": {
          "enum": [
            "measured",
            "inferred"
          ]
        },
        "instances": {
          "type": "integer",
          "minimum": 1
        },
        "routes": {
          "type": "integer",
          "minimum": 1
        },
        "measuredFrom": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^src/.+:\\d+-\\d+$"
          }
        }
      }
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "additionalProperties",
        "fields"
      ],
      "properties": {
        "additionalProperties": {
          "const": false
        },
        "fields": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "required"
            ],
            "properties": {
              "type": {
                "enum": [
                  "string",
                  "string[]",
                  "cta[]",
                  "item[]",
                  "image[]"
                ]
              },
              "required": {
                "type": "boolean"
              },
              "maxWords": {
                "type": "integer",
                "minimum": 0
              },
              "maxItems": {
                "type": "integer",
                "minimum": 0
              },
              "titleMaxWords": {
                "type": "integer",
                "minimum": 0
              },
              "bodyMaxWords": {
                "type": "integer",
                "minimum": 0
              },
              "assetRoles": {
                "type": "array",
                "items": {
                  "enum": [
                    "animation",
                    "animation-still",
                    "avatar",
                    "background",
                    "content-image",
                    "customer-logo",
                    "fictional-avatar",
                    "font",
                    "founder-contact-email",
                    "generated-illustration",
                    "hero-image",
                    "icon",
                    "illustration",
                    "live-embed",
                    "logo",
                    "original-copy",
                    "placeholder-brand-mark",
                    "placeholder-customer-logo",
                    "placeholder-screenshot",
                    "placeholder-url",
                    "user-supplied-asset",
                    "video"
                  ]
                }
              },
              "generatedAssetRoles": {
                "type": "array",
                "items": {
                  "enum": [
                    "animation",
                    "animation-still",
                    "avatar",
                    "background",
                    "content-image",
                    "customer-logo",
                    "fictional-avatar",
                    "font",
                    "founder-contact-email",
                    "generated-illustration",
                    "hero-image",
                    "icon",
                    "illustration",
                    "live-embed",
                    "logo",
                    "original-copy",
                    "placeholder-brand-mark",
                    "placeholder-customer-logo",
                    "placeholder-screenshot",
                    "placeholder-url",
                    "user-supplied-asset",
                    "video"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "onePerPage"
      ],
      "properties": {
        "onePerPage": {
          "type": "boolean"
        },
        "maxPerPage": {
          "type": "integer",
          "minimum": 2
        },
        "mustBeFirst": {
          "type": "boolean"
        },
        "mustBeLast": {
          "type": "boolean"
        },
        "noConsecutive": {
          "type": "boolean"
        }
      }
    },
    "motion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowedPatterns",
        "reducedMotionFallback"
      ],
      "properties": {
        "allowedPatterns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": {
              "none": {
                "description": "No animation.",
                "observedSections": 0
              },
              "css-transition": {
                "description": "A CSS transition on hover/focus/state change.",
                "observedSections": 42
              },
              "css-animation": {
                "description": "A CSS @keyframes animation.",
                "observedSections": 9
              },
              "appear-on-enter": {
                "description": "Element appears (fade/slide) when it enters the viewport.",
                "observedSections": 0
              },
              "scroll-linked": {
                "description": "Sticky or scroll-pinned behaviour tied to scroll position.",
                "observedSections": 5
              },
              "canvas-animation": {
                "description": "A <canvas>-rendered animation (Rive, Lottie or WebGL).",
                "observedSections": 1
              }
            }
          }
        },
        "reducedMotionFallback": {
          "enum": [
            "disable-animation",
            "instant-state"
          ]
        }
      }
    },
    "assetRoles": {
      "type": "array",
      "items": {
        "enum": [
          "animation",
          "animation-still",
          "avatar",
          "background",
          "content-image",
          "customer-logo",
          "fictional-avatar",
          "font",
          "founder-contact-email",
          "generated-illustration",
          "hero-image",
          "icon",
          "illustration",
          "live-embed",
          "logo",
          "original-copy",
          "placeholder-brand-mark",
          "placeholder-customer-logo",
          "placeholder-screenshot",
          "placeholder-url",
          "user-supplied-asset",
          "video"
        ]
      }
    },
    "generatedAssetRoles": {
      "type": "array",
      "items": {
        "enum": [
          "animation",
          "animation-still",
          "avatar",
          "background",
          "content-image",
          "customer-logo",
          "fictional-avatar",
          "font",
          "founder-contact-email",
          "generated-illustration",
          "hero-image",
          "icon",
          "illustration",
          "live-embed",
          "logo",
          "original-copy",
          "placeholder-brand-mark",
          "placeholder-customer-logo",
          "placeholder-screenshot",
          "placeholder-url",
          "user-supplied-asset",
          "video"
        ]
      }
    },
    "implementedBy": {
      "type": "string"
    },
    "scope": {
      "type": "string"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "tag",
        "file",
        "lines",
        "route"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "tag": {
          "type": "string"
        },
        "file": {
          "type": "string",
          "pattern": "^src/"
        },
        "lines": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "route": {
          "type": "string"
        }
      }
    },
    "semantic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "category"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "category": {
          "type": "string"
        }
      }
    },
    "retrievalEligible": {
      "type": "boolean"
    },
    "retrievalReason": {
      "type": "string",
      "minLength": 30
    }
  },
  "if": {
    "properties": {
      "retrievalEligible": {
        "const": false
      }
    }
  },
  "then": {
    "required": [
      "retrievalReason"
    ]
  }
}
